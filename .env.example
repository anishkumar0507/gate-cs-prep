# Copy to .env for local use; on Vercel add these under Project → Settings → Environment Variables.

# Required: key used by api/claude.js (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MODEL=claude-opus-5-5
# Comma-separated sites allowed to call /api/claude, e.g. https://your-app.vercel.app (empty = any)
ALLOWED_ORIGINS=
# AI requests allowed per visitor (IP) per hour
RATE_LIMIT_PER_HOUR=30
# If set, users must enter this code once in Settings before AI features work
ACCESS_CODE=
